# Explicit public project allowlist; unknown local files remain private.
/*
!/.gitignore
!/.gitattributes
!/app.py
!/START_DOGDEX.bat
!/CHECK_DOGDEX.bat
!/CREATE_REVIEW_ZIP.bat
!/README.txt
!/DEVELOPMENT.md
!/MOBILE_README.md
!/dogdex/
/dogdex/*
!/dogdex/*.py
!/tools/
/tools/*
!/tools/*.py
!/static/
!/tests/
/tests/*
!/tests/*.py
!/tests/*.mjs
!/tests/package.json
!/tests/package-lock.json
!/project_notes/
!/docs/
!/data/
/data/*
!/data/catalog.json
!/data/catalog.sqlite3
!/data/runtime-receipt.json
!/data/SOURCE_IDENTIFIER_RECONCILIATION_REPORT.md
!/data/images/
!/data/research/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/checks.yml
# Never include private databases, backups, local archives or development caches.
**/my_collection/
**/runtime/
**/node_modules/
**/__pycache__/
**/previous_layout/
**/backups/
**/checks/
**/*.pyc
**/*.zip
**/*.sqlite3-wal
**/*.sqlite3-shm
**/.env*
**/DogDex_Collection_Audit_*
/data/catalog-collector.sqlite3

**/*.sqlite3
**/*.db
!/data/catalog.sqlite3
